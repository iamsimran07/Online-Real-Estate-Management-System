# ==============================================================================
# Online Real Estate Management System - Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to `.env` in the project root or `backend/.env`:
#      cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. CRITICAL: NEVER commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Profile Configuration
# ------------------------------------------------------------------------------
# Active database & configuration profile:
# - Set to "postgres" to connect to hosted Supabase PostgreSQL (Production / Cloud).
# - Set to "h2" to use the embedded local file-based database (Zero-config offline dev).
SPRING_PROFILES_ACTIVE=postgres

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Connection (Profile: "postgres")
# ------------------------------------------------------------------------------
# Steps to obtain JDBC credentials from your Supabase Dashboard:
# 1. Log in to https://supabase.com and select your project.
# 2. Go to: Project Settings -> Database -> scroll down to "Connection string".
# 3. Select the "JDBC" tab.
#
# OPTION A: Connection Pooler (Recommended for Session Mode & IPv4 networks)
#   - Best compatibility with residential ISPs, cellular hotspots, and Docker.
#   - Mode: Session Mode (Port 5432) — do NOT use Transaction Mode (Port 6543) with Spring Boot/HikariCP.
#   - Host: aws-0-[REGION].pooler.supabase.com  (Port: 5432)
#   - User format: postgres.[YOUR-PROJECT-REF]
#   Example:
#   DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.abcdefghijklmnopqrst
#
# OPTION B: Direct Connection (Requires IPv6 or Supabase IPv4 Add-on)
#   - Host: db.[YOUR-PROJECT-REF].supabase.co  (Port: 5432)
#   - User: postgres
DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# ------------------------------------------------------------------------------
# 3. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Minimum 256-bit (32+ characters or 64-character hex) key for HMAC-SHA256 signing.
# Generate a secure key in your terminal:
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | % {[char]$_})
#   Bash/macOS: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_chars_or_64_hex_string_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Initial Seed User Passwords (Applied ONLY on first database run)
# ------------------------------------------------------------------------------
# When running on a fresh/empty database, default demo accounts are seeded.
# You can override their initial passwords with custom secure values here:
# (If left empty, falls back to demo passwords: admin123 / manager123 / tenant123)
SEED_ADMIN_PASSWORD=your_custom_admin_password_here
SEED_MANAGER_PASSWORD=your_custom_manager_password_here
SEED_TENANT_PASSWORD=your_custom_tenant_password_here

# ------------------------------------------------------------------------------
# 5. Server & CORS Configuration
# ------------------------------------------------------------------------------
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

