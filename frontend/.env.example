# API Base URL (defaults to http://localhost:8080/api if not specified)
VITE_API_URL=http://localhost:8080/api

# Optional Development Credentials (only used when running in dev mode: import.meta.env.DEV)
# Never commit real passwords to version control.
VITE_DEV_ADMIN_PASSWORD=
VITE_DEV_MANAGER_PASSWORD=
VITE_DEV_TENANT_PASSWORD=
